{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "evergarden-winter"
  },
  "plugins": [
    "./tui-plugin/dms-notify.ts"
  ],
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "tps": true
  },
  "animations": true,
  "tabs": {
    "mode": "on"
  }
}
